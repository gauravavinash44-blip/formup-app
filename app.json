{
  "expo": {
    "name": "FormUp",
    "slug": "formup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1116"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.formup.prototype",
      "infoPlist": {
        "NSCameraUsageDescription": "FormUp uses the camera to count your reps and check your form. Video stays on your phone unless you share it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1116"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.formup.prototype"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "FormUp uses the camera to count your reps and check your form. Video stays on your phone unless you share it.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": [
            "./assets/models/"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow FormUp to save your workout clips to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}